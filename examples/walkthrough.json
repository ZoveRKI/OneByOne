        "-export function createTodo(title: string): Todo {",
        "-  const todo: Todo = { id: uid(), title, done: false };",
        "+export function createTodo(title: string, dueDate?: string): Todo {",
        "+  if (dueDate !== undefined && !/^\\d{4}-\\d{2}-\\d{2}$/.test(dueDate)) {",
        "+    throw new Error(`dueDate 格式应为 YYYY-MM-DD：${dueDate}`);",
        "+  }",
        "+  const todo: Todo = { id: uid(), title, done: false, dueDate };",
        "   todos.push(todo);",
        "   return todo;",
        " }"
      ]
